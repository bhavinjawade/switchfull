{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switch.dev/schema/participant-request-v1alpha1",
  "additionalProperties": false,
  "type": "object",
  "required": ["requestId", "messages"],
  "properties": {
    "requestId": {
      "format": "uuid",
      "type": "string"
    },
    "messages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "anyOf": [
              {
                "const": "system",
                "type": "string"
              },
              {
                "const": "user",
                "type": "string"
              },
              {
                "const": "assistant",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              }
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "type": "string"
    },
    "outputSchema": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "sessionId": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
