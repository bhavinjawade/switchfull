{
  "name": "switch",
  "version": "0.1.0",
  "description": "A standalone LLM council, dynamic router, and test-time-compute runtime.",
  "keywords": [
    "llm",
    "ai-agents",
    "multi-agent",
    "llm-council",
    "dynamic-routing",
    "test-time-compute"
  ],
  "type": "module",
  "bin": {
    "switch": "./dist/bin/switch.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schemas": {
      "types": "./dist/src/schema/index.d.ts",
      "import": "./dist/src/schema/index.js"
    },
    "./client": {
      "types": "./dist/src/sdk/index.d.ts",
      "import": "./dist/src/sdk/index.js"
    },
    "./api": {
      "types": "./dist/src/api/index.d.ts",
      "import": "./dist/src/api/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "schemas/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run schemas:generate && tsc -p tsconfig.build.json",
    "postbuild": "node scripts/make-bin-executable.mjs",
    "dev": "tsx bin/switch.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas:generate": "tsx scripts/generate-schemas.ts && prettier --write schemas",
    "boundaries": "node scripts/check-boundaries.mjs",
    "version:check": "node scripts/check-version.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run boundaries && npm run version:check && npm run typecheck && npm test",
    "start": "node dist/bin/switch.js",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "fastify": "5.12.3",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/semver": "7.7.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
